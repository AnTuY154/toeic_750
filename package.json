{
  "name": "toeic-750-lab",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export -p web && node scripts/generate-sw.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test __tests__/*.test.ts",
    "validate": "npx expo-doctor"
  },
  "dependencies": {
    "@expo/metro-runtime": "57.0.16",
    "expo": "~57.0.10",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.9",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-linking": "~57.0.5",
    "expo-router": "~57.0.23",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "expo-asset": "~57.0.18"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.39.4",
    "eslint-config-expo": "57.0.2",
    "typescript": "~6.0.3",
    "@types/node": "^22.10.0"
  }
}
