{
  "expo": {
    "name": "750 Lab",
    "slug": "toeic-750-lab",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "toeic750lab",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-sqlite"
    ],
    "android": {
      "package": "com.antuy154.toeic750lab"
    },
    "ios": {
      "bundleIdentifier": "com.antuy154.toeic750lab",
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "name": "750 Lab",
      "shortName": "750 Lab"
    },
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/toeic_750"
    }
  }
}
